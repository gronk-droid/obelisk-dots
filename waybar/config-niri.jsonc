//              /____/

// Niri variant — top-left shows a kanji workspace indicator and a
// per-workspace window-icon strip driven by niri's event-stream IPC.
// Hyprland keeps using config.jsonc (the default path).

{
  "position": "top",
  "layer": "top",
  "height": 16,
  "margin-top": 0,
  "margin-bottom": -10,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["custom/niri-workspace", "group/niri-windows"],
  "modules-center": ["custom/playerlabel"],
  "modules-right": ["clock", "group/group-applets"],

  // ── Workspace indicator ────────────────────────────────────────
  // Kanji glyph for the focused workspace's per-output index (1→一 … 10→〇).
  // Scroll up = workspace -1, scroll down = workspace +1, clamped [1, 10].
  "custom/niri-workspace": {
    "exec": "~/.config/waybar/scripts/niri-ws.py slot",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "on-scroll-up":   "~/.config/waybar/scripts/niri-ws.py scroll up",
    "on-scroll-down": "~/.config/waybar/scripts/niri-ws.py scroll down"
  },

  // ── Per-workspace window strip ─────────────────────────────────
  // Shows icons only for windows in the focused workspace, in layout
  // order (left-to-right columns, top-to-bottom within each column).
  // Clicking focuses a specific window; scrolling moves through the
  // list clamped at first/last (no wrap).
  "group/niri-windows": {
    "orientation": "inherit",
    "modules": [
      "custom/niri-window-0",  "custom/niri-window-1",  "custom/niri-window-2",
      "custom/niri-window-3",  "custom/niri-window-4",  "custom/niri-window-5",
      "custom/niri-window-6",  "custom/niri-window-7",  "custom/niri-window-8",
      "custom/niri-window-9",  "custom/niri-window-10", "custom/niri-window-11",
      "custom/niri-window-12", "custom/niri-window-13", "custom/niri-window-14",
      "custom/niri-window-15", "custom/niri-window-16", "custom/niri-window-17",
      "custom/niri-window-18", "custom/niri-window-19"
    ]
  },

  "custom/niri-window-0":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 0",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 0",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-1":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 1",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 1",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-2":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 2",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 2",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-3":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 3",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 3",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-4":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 4",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 4",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-5":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 5",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 5",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-6":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 6",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 6",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-7":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 7",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 7",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-8":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 8",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 8",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-9":  { "exec": "~/.config/waybar/scripts/niri-win.py slot 9",  "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 9",  "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-10": { "exec": "~/.config/waybar/scripts/niri-win.py slot 10", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 10", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-11": { "exec": "~/.config/waybar/scripts/niri-win.py slot 11", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 11", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-12": { "exec": "~/.config/waybar/scripts/niri-win.py slot 12", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 12", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-13": { "exec": "~/.config/waybar/scripts/niri-win.py slot 13", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 13", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-14": { "exec": "~/.config/waybar/scripts/niri-win.py slot 14", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 14", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-15": { "exec": "~/.config/waybar/scripts/niri-win.py slot 15", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 15", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-16": { "exec": "~/.config/waybar/scripts/niri-win.py slot 16", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 16", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-17": { "exec": "~/.config/waybar/scripts/niri-win.py slot 17", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 17", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-18": { "exec": "~/.config/waybar/scripts/niri-win.py slot 18", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 18", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },
  "custom/niri-window-19": { "exec": "~/.config/waybar/scripts/niri-win.py slot 19", "return-type": "json", "signal": 8, "interval": "once", "on-click": "~/.config/waybar/scripts/niri-win.py focus 19", "on-scroll-up": "~/.config/waybar/scripts/niri-win.py scroll up", "on-scroll-down": "~/.config/waybar/scripts/niri-win.py scroll down" },

  // ── Clock ──────────────────────────────────────────────────────
  "clock": {
    "format": "{:%I:%M:%S}",
    "interval": 1,
    "format-alt": "{:%a %Y-%m-%d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months":   "<span color='#ffead3'><b>{}</b></span>",
        "days":     "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":    "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today":    "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right":    "mode",
      "on-click-forward":  "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up":      "shift_up",
      "on-scroll-down":    "shift_down"
    }
  },

  // ── Media player ──────────────────────────────────────────────
  "custom/playerlabel": {
    "format": "<span>{}</span>",
    "return-type": "json",
    "max-length": 80,
    "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "on-click-middle": "playerctl play-pause",
    "on-click": "playerctl previous",
    "on-click-right": "playerctl next",
    "format-icons": {
      "Playing": "<span foreground='#B1B946'>󰒮 󰐌  󰒭</span>",
      "Paused":  "<span foreground='#47423E'>󰒮 󰏥  󰒭</span>"
    }
  },

  // ── System modules ────────────────────────────────────────────
  "battery": {
    "states": { "good": 95, "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󱐋",
    "format-alt": "{icon} <span font='Iosevka NFP'>{capacity}% | {time}</span>",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 1,
    "tooltip-format": "{capacity}% - {time}"
  },

  "memory": {
    "format": "󰍛 {}%",
    "format-alt": "󰍛 {used}/{total} GiB",
    "interval": 1
  },

  "cpu": {
    "format": "󰻠  {usage}%",
    "format-alt": "󰻠  {avg_frequency} GHz",
    "interval": 1
  },

  "disk": {
    "format": "󰆼 {percentage_used}%",
    "format-alt": "󰆼 {used}/{total} GiB",
    "interval": 1,
    "path": "/"
  },

  "custom/gpu-usage": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "format": "󰢮 {}%",
    "return-type": "",
    "interval": 1
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "󰤭",
    "format-alt": "󰈀 {ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{essid}"
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "on-click": "bash ~/.config/waybar/scripts/bluetooth.sh",
    "on-click-right": "bash ~/.config/waybar/scripts/bluetoggle.sh",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },

  "custom/notifications": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification":           "󰂚<span foreground='#DB4740'><sup></sup></span>",
      "none":                   "󰂚",
      "dnd-notification":       "󰂛<span foreground='#DB4740'><sup></sup></span>",
      "dnd-none":               "󰂛",
      "inhibited-notification": "󰂚<span foreground='#DB4740'><sup></sup></span>",
      "inhibited-none":         "󰂚",
      "dnd-inhibited-notification": "󰂛<span foreground='#DB4740'><sup></sup></span>",
      "dnd-inhibited-none":     "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "tray": {
    "icon-size": 16,
    "spacing": 5
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "tooltip-format": "{percent}%"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "audio-select",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "bash ~/.config/rofi/applets/bin/volume.sh --row 3",
    "tooltip-format": "{volume}%"
  },

  "custom/launcher": {
    "format": "",
    "on-click": "exec wofi",
    "on-click-right": "exec wofi"
  },

  "custom/screenshot_t": {
    "format": "",
    "on-click":       "niri msg action screenshot-screen",
    "on-click-right": "niri msg action screenshot"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "group/group-applets": {
    "orientation": "inherit",
    "modules": [
      "network",
      "pulseaudio",
      "custom/screenshot_t",
      "custom/power"
    ]
  }
}
