// https://github.com/Axenide/Dotfiles

// MODIFIED BY LAGGY TUX (github.com./laggy-tux)

{
  "position": "top",
  "layer": "top",
  "height": 16,
  "margin-top": 0,
  "margin-bottom": -10,
  "margin-left": 0,
  "margin-right": 0,
  //   "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/playerlabel"],
  "modules-right": ["clock", "group/group-applets"],
  // Modules configuration
  "clock": {
    "format": "{:%I:%M:%S}",
    "interval": 1,
    "format-alt": "{:%a %Y-%m-%d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
    // "on-click-right": "bash ~/.config/rofi/calendar/calendar.sh"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "format": "<span>{icon}</span>",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "〇"
      // "active": "",
      // "default": ""
    },
    "persistent-workspaces": {
      "DP-1": [1, 2, 3, 4, 5],
      "HDMI-A-1": [6, 7, 8, 9, 10]
    }
  },

  // "custom/playerctl": {
  //   "format": "{}  ",
  //   "return-type": "json",
  //   "max-length": 64,
  //   "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
  //   "on-click-middle": "playerctl play-pause",
  //   "on-click": "playerctl previous",
  //   "on-click-right": "playerctl next",
  //   "format-icons": {
  //     "Playing": "<span foreground='#B1B946'>󰝚</span>",
  //     "Paused": "<span foreground='#47423E'>󰝛</span>"
  //   }
  // },

  // "custom/spotify": {
  //   "exec": "~/.config/waybar/scripts/mediaplayer.py --player spotify",
  //   "format": "<span>{}  </span>",
  //   "return-type": "json",
  //   "on-click": "playerctl play-pause",
  //   "on-scroll-up": "playerctl next",
  //   "on-scroll-down": "playerctl previous"
  // },

  "custom/playerlabel": {
    "format": "<span>{}</span>",
    "return-type": "json",
    "max-length": 80,
    "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "on-click-middle": "playerctl play-pause",
    "on-click": "playerctl previous",
    "on-click-right": "playerctl next",
    "format-icons": {
      "Playing": "<span foreground='#B1B946'>󰒮 󰐌  󰒭</span>",
      "Paused": "<span foreground='#47423E'>󰒮 󰏥  󰒭</span>"
    }
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󱐋",
    "format-alt": "{icon} <span font='Iosevka NFP'>{capacity}% | {time}</span>",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 1,
    "tooltip-format": "{capacity}% - {time}"
  },

  "memory": {
    "format": "󰍛 {}%",
    "format-alt": "󰍛 {used}/{total} GiB",
    "interval": 1
  },

  "cpu": {
    "format": "󰻠  {usage}%",
    "format-alt": "󰻠  {avg_frequency} GHz",
    "interval": 1
  },

  "disk": {
    "format": "󰆼 {percentage_used}%",
    "format-alt": "󰆼 {used}/{total} GiB",
    "interval": 1,
    "path": "/"
  },

  "disk#2": {
    "format": "󰋊 {percentage_used}%",
    "format-alt": "󰋊 {used}/{total} GiB",
    "interval": 1,
    "path": "/home/adriano"
  },

  "custom/gpu-usage": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "format": "󰢮 {}%",
    "return-type": "",
    "interval": 1
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀  {ifname} (No IP)",
    "format-disconnected": "󰤭",
    "format-alt": "󰈀 {ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{essid}"
    // "on-click-right": "python ~/.config/rofi/network/network.py",
    // "on-click": "nm-applet --indicator"
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "on-click": "bash ~/.config/waybar/scripts/bluetooth.sh",
    "on-click-right": "bash ~/.config/waybar/scripts/bluetoggle.sh",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },

  "custom/notifications": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚<span foreground='#DB4740'><sup></sup></span>",
      "none": "󰂚",
      "dnd-notification": "󰂛<span foreground='#DB4740'><sup></sup></span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚<span foreground='#DB4740'><sup></sup></span>",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛<span foreground='#DB4740'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "tray": {
    "icon-size": 16,
    "spacing": 5
  },

  "backlight": {
    // "device": "acpi_video1",
    "format": "{icon}",
    "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    //	"on-scroll-up":,
    //	"on-scroll-down":,
    "tooltip-format": "{percent}%"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pamixer -t",
    "on-click-right": "bash ~/.config/rofi/applets/bin/volume.sh --row 3",
    "tooltip-format": "{volume}%"
  },
  "custom/randwall": {
    "format": "󰏘",
    "on-click": "nemo ~/Wallpapers/Selected",
    "on-click-right": "nemo ~/Wallpapers"
  },
  "custom/launcher": {
    "format": "",
    "on-click": "exec wofi",
    "on-click-right": "exec wofi"
  },

  "custom/wf-recorder": {
    "format": "{}",
    "interval": "once",
    "exec": "echo ''",
    "tooltip": "false",
    "exec-if": "pgrep 'wf-recorder'",
    "on-click": "exec ./scripts/wlrecord.sh",
    "signal": 8
  },

  "custom/hyprpicker": {
    "format": "󰈋",
    "on-click": "bash ~/.config/waybar/scripts/hyprpicker-hex.sh",
    "on-click-right": "bash ~/.config/waybar/scripts/hyprpicker-rgb.sh"
  },

  "custom/screenshot_t": {
    "format": "",
    "on-click": "bash ~/.config/hypr/scripts/screenshot_full",
    "on-click-right": "bash ~/.config/hypr/scripts/screenshot_area"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "group/group-applets": {
    "orientation": "inherit",
    "modules": [
      "network",
      "pulseaudio",
      "custom/hyprpicker",
      "custom/screenshot_t",
      "custom/power"
    ]
  }
}
